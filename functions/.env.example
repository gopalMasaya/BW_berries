# FieldClimate API credentials and channel mapping.
#
# Copy this file to functions/.env and fill it in. .env is already covered by
# .gitignore, so it never reaches the repo. Firebase Functions v2 loads
# functions/.env automatically at deploy time, so no separate secret upload.
#
# The HMAC key pair comes from fieldclimate.com > user menu > API services.
# It is NOT the OAuth 2.0 client id/secret -- those are a different pair on the
# same page and will fail with 401.
FC_PUBLIC_KEY=
FC_PRIVATE_KEY=

# The 8-character FieldClimate device id, and the sensor channels that carry
# air temperature and relative humidity. Run
#   node tools/fc-discover.js
# once with the keys above filled in and it prints exactly these five lines.
FC_STATION_ID=
FC_TEMP_CODE=
FC_TEMP_CH=
FC_RH_CODE=
FC_RH_CH=
